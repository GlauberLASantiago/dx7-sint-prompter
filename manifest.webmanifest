{
  "name": "DX7 FM Synth & AI Prompt Builder",
  "short_name": "DX7 FM",
  "description": "Aplicativo PWA para testar presets de síntese FM inspirados no DX7 e gerar prompts para IA com Web Audio API.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111111",
  "theme_color": "#111111",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
